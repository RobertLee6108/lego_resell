# Supabase — 환경별 파일로 분리 (이 파일에 NEXT_PUBLIC_* 넣지 마세요)
# https://supabase.com/dashboard/project/_/settings/api
#
# npm run dev     → .env.development.local
# npm run build   → .env.production.local
# npm run deploy  → .env.production.local + .dev.vars (Wrangler runtime)
# npm run seed:users → .dev.vars(URL) + 여기 service_role
#
# 예시는 .env.development.local.example / .env.production.local.example 참고

# Admin API (npm run seed:users)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
