# cp .env.development.local.example .env.development.local
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<Publishable key from `npx supabase status`>
NAVER_SEARCH_CLIENT_ID=your-naver-search-client-id
NAVER_SEARCH_CLIENT_SECRET=your-naver-search-client-secret
BATCH_API_TOKEN=local-batch-token
SUPABASE_SERVICE_ROLE_KEY=<Service role key from `npx supabase status`>
